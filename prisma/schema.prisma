generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Game {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  category    String
  coverImage  String?
  bannerImage String?
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  services    Service[]
  serviceCategories Json?
  blogPosts   BlogPost[]
  coupons     Coupon[]
  campaigns   Campaign[]
}

model Service {
  id          Int      @id @default(autoincrement())
  gameId      Int
  game        Game     @relation(fields: [gameId], references: [id])
  name        String
  slug        String
  priceType   String   @default("fixed")
  basePrice   Float
  description String?
  features    Json?
  imageUrl    String?
  options     Json?
  addons      Json?
  discoveryGoals Json?
  isActive    Boolean  @default(true)
  isHot       Boolean  @default(false)
  createdAt   DateTime @default(now())
  orders      Order[]
  serviceCategory String? @default("Genel")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  passwordHash String?
  oauthProvider String?
  displayName  String?
  discordId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  emailVerified               Boolean   @default(false)
  verificationTokenHash       String?
  verificationTokenExpiry     DateTime?
  resetTokenHash              String?
  resetTokenExpiry            DateTime?
  termsAcceptedAt              DateTime?

  billingName       String?
  billingAddress    String?
  billingCity       String?
  billingCountry    String?
  billingPhone      String?
  billingPostalCode String?

  isContentCreator Boolean @default(false)
  isAdmin          Boolean @default(false)

  bonusPoints         Int      @default(0)
  referralCode        String?  @unique
  referredById        Int?
  referredBy          User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]   @relation("Referrals")
  referralRewardGiven Boolean  @default(false)

  orders        Order[]
  booster       Booster?
  notifications Notification[]
  messages      Message[]
  blogPosts     BlogPost[]
  applications  Application[]
}

model Booster {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id])
  discordId      String?
  games          Json?
  status         String   @default("active")
  completedCount Int      @default(0)
  rating         Float    @default(0)
  createdAt      DateTime @default(now())
  orders         Order[]
}

model Order {
  id          Int      @id @default(autoincrement())
  orderNumber String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id])
  boosterId   Int?
  booster     Booster? @relation(fields: [boosterId], references: [id])
  status      String   @default("pending")
  price       Float
  currency    String   @default("USD")
  details     Json?
  rating      Int?
  review      String?
  ratedAt     DateTime?
  issueReport      String?
  issueReportedAt  DateTime?
  issueResolved    Boolean   @default(false)
  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]

  originalPrice  Float?
  discountAmount Float   @default(0)
  discountSource String?
  couponId       Int?
  coupon         Coupon? @relation(fields: [couponId], references: [id])
  couponCode     String?
}

model Coupon {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  type         String    // 'percent' | 'fixed'
  value        Float
  minSpend     Float?
  maxUses      Int?
  usedCount    Int       @default(0)
  perUserLimit Int?      @default(1)
  gameId       Int?
  game         Game?     @relation(fields: [gameId], references: [id])
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  orders       Order[]
}

model Campaign {
  id          Int       @id @default(autoincrement())
  name        String
  discountPct Float
  gameId      Int?
  game        Game?     @relation(fields: [gameId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value Json
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Message {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  senderId  Int
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model BlogPost {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  category    String    @default("Guide")
  gameId      Int?
  game        Game?     @relation(fields: [gameId], references: [id])
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dailyViews  BlogPostDailyView[]
  reviewStatus String    @default("draft") // draft | pending | approved | rejected
  reviewNote   String?

  @@index([isPublished, publishedAt])
}

model BlogPostDailyView {
  id         Int      @id @default(autoincrement())
  blogPostId Int
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id])
  date       DateTime @db.Date
  views      Int      @default(0)

  @@unique([blogPostId, date])
}

model Application {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  type        String   // 'booster' | 'content_creator'
  status      String   @default("pending") // pending | approved | rejected
  discord     String?
  telegram    String?
  games       Json?
  experience  String?
  screenshots Json?
  extra       Json?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, status])
}
